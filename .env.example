# 環境変数の雛形。コピーして .env にリネームし、値を設定してください。
#   cp .env.example .env
# .env は .gitignore で除外済みです（機密値をgitに入れないこと）。

# ── ログイン認証 ────────────────────────────────
# APP_PASSWORD が空の場合は認証なしで動作します（ローカル開発用）
APP_USERNAME=admin
APP_PASSWORD=

# ── freee API連携（任意）────────────────────────
# 未設定の場合、画面の「freeeから取得」タブは表示されません（CSVのみで動作）
# 値は freee アプリストアの「アプリ管理」から取得します。
FREEE_CLIENT_ID=
FREEE_CLIENT_SECRET=
# ⚠️ 重要: 下記URLは freee 側のアプリ設定「コールバックURL」と
#    完全に一致している必要があります（不一致だと認可が弾かれます）。
#    サーバーを引っ越してドメインが変わったら、両方を必ず更新してください。
#    本番は https 必須です（http や IP直打ちは freee 側で登録できません）。
FREEE_REDIRECT_URI=https://example.com/api/freee/callback

# ── 前期データ・freeeトークンの保存先（任意）──────────
# 【設定する場合】Supabaseストレージに保存されます。
#   サーバーを引っ越しても、同じ値を設定すれば保存済みデータをそのまま使えます。
# 【空にする場合】サーバー内の backend/client_data/ に保存されます。
#   VPS（ConoHa等）のように永続ディスクがある環境ではこちらでも問題ありません。
#   ※ Render無料プランは再デプロイで消えるためSupabaseが必須でした。
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_BUCKET=kaikei-client-data

# ── AI選別層（任意）─────────────────────────────
# 未設定ならルールベースのみで動作します（重複仕訳の精査が無効になるだけ）
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-4-8
