# 環境変数の雛形。コピーして .env にリネームし、値を設定してください。
#   cp .env.example .env
# .env は .gitignore で除外済みです（機密値をgitに入れないこと）。

# ── ログイン認証 ────────────────────────────────
# APP_PASSWORD が空の場合は認証なしで動作します（ローカル開発用）
APP_USERNAME=admin
APP_PASSWORD=

# ── freee API連携（任意）────────────────────────
# 未設定の場合、画面の「freeeから取得」タブは表示されません（CSVのみで動作）
# 値は freee アプリストアの「アプリ管理」から取得します。
FREEE_CLIENT_ID=
FREEE_CLIENT_SECRET=
# ⚠️ 重要: 下記URLは freee 側のアプリ設定「コールバックURL」と
#    完全に一致している必要があります（不一致だと認可が弾かれます）。
#    サーバーを引っ越してドメインが変わったら、両方を必ず更新してください。
#    本番は https 必須です（http や IP直打ちは freee 側で登録できません）。
FREEE_REDIRECT_URI=https://example.com/api/freee/callback

# ── 前期データ・freeeトークンの保存先 ────────────────
# 空のままにしてください（推奨）。サーバー内の backend/client_data/ に保存されます。
# VPS（ConoHa等）は永続ディスクがあるため、外部ストレージは不要です。
#
# ※ 以下はRender無料プラン時代の名残です（再デプロイでデータが消えるため
#   Supabaseに逃がしていた）。値を設定するとSupabase保存に切り替わります。
#   Supabaseからサーバー内保存へ移行するには:
#     python backend/tools/migrate_from_supabase.py
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_BUCKET=kaikei-client-data

# ── AI機能（任意）───────────────────────────────
# 設定すると、次の3つが有効になります（未設定でもルールベースは通常どおり動作）:
#   ・重複仕訳のAI選別        ・見逃し観点のAI探索
#   ・チェックの意図に照らした精査（誤検知の降格／条件外の観点の抽出）
# APIキーは https://console.anthropic.com の「API Keys」で発行します。
ANTHROPIC_API_KEY=
# 既定は claude-opus-5（判断精度が最も高い）。
# コストを抑えたい場合は claude-haiku-4-5 に変更できます。
AI_MODEL=claude-opus-5
